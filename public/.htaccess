# Viva Algérie — Apache / cPanel / Hostinger
# Canonical: https://vivaalgerie.com

Options -Indexes
ServerSignature Off

# UTF-8
AddDefaultCharset UTF-8

# 404
ErrorDocument 404 /404.html

# PHP remains executable
<FilesMatch "\.php$">
  SetHandler application/x-httpd-php
</FilesMatch>

# Force HTTPS + non-www
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect www → non-www (HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.vivaalgerie\.com$ [NC]
  RewriteRule ^(.*)$ https://vivaalgerie.com/$1 [L,R=301]

  # Redirect HTTP → HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://vivaalgerie.com/$1 [L,R=301]

  # Clean URLs without .html when file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

# Security headers (no strict CSP)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-XSS-Protection "1; mode=block"

  # Long cache for static assets
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Do not cache PHP endpoints
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Protect sensitive files
<FilesMatch "(^\.htaccess|\.env|\.git)">
  Require all denied
</FilesMatch>
