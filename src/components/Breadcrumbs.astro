---
import Icon from './Icon.astro';

interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Fil d’Ariane" class="mb-8">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
    {
      items.map((item, i) => (
        <li class="inline-flex items-center gap-2">
          {i > 0 && (
            <span aria-hidden="true" class="text-border">
              /
            </span>
          )}
          {i === items.length - 1 ? (
            <span class="text-text" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="hover:text-green">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
