---
import Icon from './Icon.astro';

interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {
    items.map((item, i) => (
      <details
        class="group rounded-[var(--radius-card)] border border-border bg-bg px-5 py-4 open:bg-bg-secondary"
        open={i === 0}
      >
        <summary class="cursor-pointer list-none font-serif text-lg marker:content-none [&::-webkit-details-marker]:hidden">
          <span class="flex items-start justify-between gap-4">
            <span>{item.question}</span>
            <span class="mt-1 text-green transition group-open:rotate-45">+</span>
          </span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-muted">{item.answer}</p>
      </details>
    ))
  }
</div>
