---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  CATEGORY_PATHS,
  SAFE_PATH,
  BLOG_PATH,
  HOME_PATH,
  type Locale,
} from '../lib/site';
import { getLegalPaths } from '../lib/paths';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
  languagePaths?: Partial<Record<Locale, string>>;
}

const { locale = 'fr', languagePaths } = Astro.props;
const legal = getLegalPaths(locale);
const home = HOME_PATH[locale];

const links =
  locale === 'fr'
    ? [
        { href: CATEGORY_PATHS.fr.actualite, label: t(locale, 'nav.actualite') },
        { href: CATEGORY_PATHS.fr.algerie, label: t(locale, 'nav.algerie') },
        {
          href: CATEGORY_PATHS.fr['sahara-occidental'],
          label: t(locale, 'nav.sahara-occidental'),
        },
        {
          href: CATEGORY_PATHS.fr['algerie-maroc'],
          label: t(locale, 'nav.algerie-maroc'),
        },
        { href: CATEGORY_PATHS.fr.tourisme, label: t(locale, 'nav.tourisme') },
        { href: CATEGORY_PATHS.fr.economie, label: t(locale, 'nav.economie') },
        { href: CATEGORY_PATHS.fr.culture, label: t(locale, 'nav.culture') },
        { href: CATEGORY_PATHS.fr.analyses, label: t(locale, 'nav.analyses') },
      ]
    : [
        { href: BLOG_PATH[locale], label: t(locale, 'nav.blog') },
        { href: CATEGORY_PATHS[locale].immobilier, label: t(locale, 'nav.immobilier') },
        { href: CATEGORY_PATHS[locale].tourisme, label: t(locale, 'nav.tourisme') },
        { href: CATEGORY_PATHS[locale].investissement, label: t(locale, 'nav.investissement') },
        { href: CATEGORY_PATHS[locale].villes, label: t(locale, 'nav.villes') },
        { href: CATEGORY_PATHS[locale].guides, label: t(locale, 'nav.guides') },
        { href: SAFE_PATH[locale], label: t(locale, 'nav.safe') },
      ];
---

<header class="sticky top-0 z-50 border-b border-border bg-glass backdrop-blur-xl">
  <div class="container-editorial flex h-16 items-center justify-between gap-4 sm:h-[4.25rem]">
    <a href={home} class="group flex items-center gap-2.5" aria-label="Viva Algérie">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full bg-green text-white transition group-hover:scale-105"
        aria-hidden="true"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M12 3l7 4v5c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V7l7-4z" stroke="currentColor" stroke-width="1.6" />
          <path d="M9.5 12.5l1.8 1.8 3.7-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="font-serif text-lg tracking-tight sm:text-xl">
        Viva <span class="text-green">Algérie</span>
      </span>
    </a>

    <nav class="hidden items-center gap-0.5 xl:flex" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-2.5 py-2 text-sm text-muted hover:bg-green-soft hover:text-green"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} paths={languagePaths} />
      <a href={legal.contact} class="btn-primary hidden !px-4 !py-2 text-xs sm:inline-flex">
        {t(locale, 'nav.contact')}
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
        aria-label={t(locale, 'nav.menu')}
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-border bg-bg xl:hidden" data-mobile-nav>
    <nav class="container-editorial flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        links.map((link) => (
          <a href={link.href} class="rounded-xl px-3 py-3 text-sm hover:bg-bg-secondary">
            {link.label}
          </a>
        ))
      }
      <a href={legal.contact} class="rounded-xl px-3 py-3 text-sm font-medium text-green">
        {t(locale, 'nav.contact')}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-mobile-nav]');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
