---
import { CATEGORY_LABELS } from '../i18n/ui';
import { formatDate, getArticlePath, getCategoryPath } from '../lib/paths';
import type { Category, Locale } from '../lib/site';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: Category;
  lang: Locale;
  pubDate: Date;
  image: string;
  imageAlt: string;
  featured?: boolean;
}

const {
  title,
  description,
  slug,
  category,
  lang,
  pubDate,
  image,
  imageAlt,
  featured = false,
} = Astro.props;

const href = getArticlePath(lang, slug);
const categoryHref = getCategoryPath(lang, category);
---

<article class:list={['card-editorial group', featured && 'sm:col-span-2 lg:col-span-2']}>
  <a href={href} class="block overflow-hidden">
    <div class:list={['relative overflow-hidden bg-bg-secondary', featured ? 'aspect-[16/9]' : 'aspect-[16/10]']}>
      <img
        src={image}
        alt={imageAlt}
        class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
        loading={featured ? 'eager' : 'lazy'}
        width={featured ? 1200 : 800}
        height={featured ? 675 : 500}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
    </div>
  </a>
  <div class="p-5 sm:p-6">
    <div class="mb-3 flex flex-wrap items-center gap-3 text-xs">
      <a href={categoryHref} class="rounded-full bg-green-soft px-3 py-1 font-medium text-green">
        {CATEGORY_LABELS[lang][category]}
      </a>
      <time datetime={pubDate.toISOString()} class="text-muted">
        {formatDate(pubDate, lang)}
      </time>
    </div>
    <h3 class:list={['mb-2 font-serif leading-snug', featured ? 'text-2xl sm:text-3xl' : 'text-xl']}>
      <a href={href} class="hover:text-green">{title}</a>
    </h3>
    <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>
    <a href={href} class="inline-flex items-center gap-2 text-sm font-medium text-green">
      {t(lang, 'cta.readArticle')}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</article>
