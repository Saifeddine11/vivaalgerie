---
import PageLayout from '../../layouts/PageLayout.astro';
import { absoluteUrl, getLegalPaths } from '../../lib/paths';
import { SITE } from '../../lib/site';
import type { Locale } from '../../lib/site';

const locale: Locale = 'nl';
const canonical = absoluteUrl(getLegalPaths(locale).mentions);
---

<PageLayout
  title="Juridische vermelding — Viva Algérie"
  description="Juridische vermelding van de redactionele site Viva Algérie."
  locale={locale}
  canonical={canonical}
  showNewsletter={false}
>
  <section class="section-pad">
    <div class="container-editorial prose-editorial max-w-3xl">
      <h1>Juridische vermelding</h1>
      <h2>Uitgever</h2>
      <p>
        De website <strong>Viva Algérie</strong> (https://vivaalgerie.com) is een redactionele
        informatiesite gewijd aan vastgoed, toerisme en investeringen in Algerije.
      </p>
      <p>
        Redactioneel contact: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p>
        Er wordt geen handelsregisternummer op deze pagina getoond zolang dit niet door de
        uitgever is meegedeeld. De informatie wordt bijgewerkt zodra beschikbaar.
      </p>

      <h2>Aard van de inhoud</h2>
      <p>
        Artikelen, gidsen en thematische pagina’s zijn redactionele en pedagogische analyses. Zij
        <strong>vormen geen</strong> juridisch, fiscaal, financieel, notarieel of beleggingsadvies.
        Elke aankoop- of investeringsbeslissing moet voorafgaan door controles bij gekwalificeerde
        professionals (met name een notaris).
      </p>

      <h2>Intellectuele eigendom</h2>
      <p>
        Teksten, het merk Viva Algérie en
        grafische elementen van de site zijn beschermd. Ongeautoriseerde reproductie is verboden.
      </p>

      <h2>Hosting</h2>
      <p>
        De site is ontworpen voor statische uitrol op Apache / cPanel-hosting (bijv. Hostinger).
        Contact- en nieuwsbriefformulieren gebruiken lokale PHP-scripts
        (<code>send-contact.php</code>, <code>send-newsletter.php</code>).
      </p>

      <h2>Aansprakelijkheid</h2>
      <p>
        Ondanks zorg bij de verificatie van informatie kan de uitgever de volledigheid of
        permanente actualiteit van elke inhoud niet garanderen. Externe links worden ter informatie gegeven.
      </p>
    </div>
  </section>
</PageLayout>
