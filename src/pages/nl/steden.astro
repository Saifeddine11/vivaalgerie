---
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CITIES } from '../../lib/site';
import { absoluteUrl, getHomePath } from '../../lib/paths';
import { getArticlesByCategory } from '../../lib/content';
import { t } from '../../i18n/ui';
import type { Locale } from '../../lib/site';

const locale: Locale = 'nl';
const articles = await getArticlesByCategory('villes', locale);
const canonical = absoluteUrl('/nl/steden');
const hreflang = [
  { lang: 'fr', href: absoluteUrl('/villes') },
  { lang: 'en', href: absoluteUrl('/en/cities') },
  { lang: 'es', href: absoluteUrl('/es/ciudades') },
  { lang: 'nl', href: absoluteUrl('/nl/steden') },
  { lang: 'x-default', href: absoluteUrl('/villes') },
];
---

<PageLayout
  title="Steden van Algerije — Algiers, Oran, Constantine en verder"
  description="Stedelijke gidsen Algerije: Algiers, Oran, Constantine, Annaba, Béjaïa, Tipaza en lokale vastgoed-/toerismedynamiek."
  locale={locale}
  canonical={canonical}
  hreflang={hreflang}
>
  <section class="border-b border-border bg-bg-secondary">
    <div class="container-editorial max-w-4xl py-14 sm:py-20">
      <Breadcrumbs
        items={[
          { label: t(locale, 'breadcrumb.home'), href: getHomePath(locale) },
          { label: 'Steden', href: canonical },
        ]}
      />
      <p class="eyebrow mb-3">Steden</p>
      <h1 class="mb-5 text-4xl sm:text-5xl">Steden van Algerije</h1>
      <p class="max-w-2xl text-lg text-muted">
        Begrijp lokale dynamiek: regionale hoofdsteden, kust en secundaire steden om te volgen voor vastgoed en toerisme.
      </p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-editorial">
      <h2 class="mb-8 text-3xl">Steden om te volgen</h2>
      <div class="mb-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          CITIES.map((city) => (
            <div
              id={city.slug}
              class="scroll-mt-24 rounded-[var(--radius-card)] border border-border bg-bg p-5"
            >
              <h3 class="font-serif text-xl">{city.name.nl}</h3>
              <p class="mt-2 text-sm text-muted">
                Redactionele focus: vastgoed, bereikbaarheid en lokaal toeristisch potentieel.
              </p>
            </div>
          ))
        }
      </div>

      <h2 class="mb-8 text-3xl">Artikelen</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              slug={article.data.slug}
              category={article.data.category}
              lang={locale}
              pubDate={article.data.pubDate}
              image={article.data.image}
              imageAlt={article.data.imageAlt}
            />
          ))
        }
      </div>

      <aside class="mt-16 rounded-[var(--radius-card)] border border-border bg-bg-secondary p-8">
        <h2 class="mb-4 text-2xl">Gerelateerde bronnen</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          <li><a href="/nl/vastgoed" class="text-green hover:underline">Vastgoed →</a></li>
          <li><a href="/nl/toerisme" class="text-green hover:underline">Toerisme →</a></li>
          <li><a href="/nl/vastgoedprijzen-algiers" class="text-green hover:underline">Prijzen in Algiers →</a></li>
          <li><a href="/nl/investeren" class="text-green hover:underline">Investeren →</a></li>
        </ul>
      </aside>
    </div>
  </section>
</PageLayout>
