---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { absoluteUrl, getHomePath, getLegalPaths } from '../lib/paths';
import { SITE } from '../lib/site';
import { t } from '../i18n/ui';

const locale = 'fr' as const;
const canonical = absoluteUrl(getLegalPaths(locale).about);
const hreflang = [
  { lang: 'fr', href: canonical },
  { lang: 'en', href: absoluteUrl('/en/about') },
  { lang: 'es', href: absoluteUrl('/es/sobre-nosotros') },
  { lang: 'nl', href: absoluteUrl('/nl/over-ons') },
  { lang: 'x-default', href: canonical },
];
---

<PageLayout
  title="À propos — Viva Algérie"
  description="Viva Algérie est un média éditorial français sur l’Algérie, le Sahara occidental, les relations Algérie–Maroc, le tourisme, l’économie, la culture et les analyses."
  locale={locale}
  canonical={canonical}
  hreflang={hreflang}
>
  <section class="section-pad">
    <div class="container-editorial max-w-3xl">
      <Breadcrumbs
        items={[
          { label: t(locale, 'breadcrumb.home'), href: getHomePath(locale) },
          { label: t(locale, 'about.title'), href: canonical },
        ]}
      />
      <h1 class="mb-6 text-4xl sm:text-5xl">À propos de Viva Algérie</h1>
      <div class="prose-editorial">
        <p>
          <strong>Viva Algérie</strong> est un média éditorial indépendant consacré à l’Algérie,
          à son actualité, au Sahara occidental, aux relations Algérie–Maroc, au tourisme,
          à l’économie, à la culture, à la diaspora et aux grandes analyses du Maghreb.
          Notre ligne : expliquer, contextualiser et donner au lecteur des repères sourcés,
          sans confondre perspective éditoriale et affirmation officielle.
        </p>
        <p>
          Nous publions des analyses, des guides pratiques et des dossiers thématiques destinés
          aux lecteurs francophones, à la diaspora, aux observateurs du Maghreb et à toute personne
          qui souhaite mieux comprendre la réalité algérienne dans ses dimensions politiques,
          économiques, culturelles et territoriales.
        </p>
        <h2>Notre méthode</h2>
        <ul>
          <li>Priorité aux sources publiques et vérifiables : ONU, institutions algériennes, sources marocaines officielles lorsque leur position est présentée, agences reconnues et données économiques.</li>
          <li>Distinction claire entre faits établis, hypothèses et lectures éditoriales.</li>
          <li>Traitement des sujets géopolitiques sans insulte, sans haine nationale et sans présenter les désaccords internationaux comme déjà tranchés lorsqu’ils ne le sont pas.</li>
          <li>Immobilier et investissement restent des rubriques secondaires ; S.A.F.E y est présenté comme une méthode internationale propriétaire d’analyse et de présélection immobilière, jamais comme un label d’État.</li>
        </ul>
        <h2>Indépendance éditoriale</h2>
        <p>
          Les contenus publiés sur Viva Algérie sont des analyses éditoriales fondées sur des
          sources publiques. Ils ne constituent pas une position officielle d’un État, d’une
          institution ou d’une organisation internationale.
        </p>
        <h2>Contact</h2>
        <p>
          Rédaction : <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          Site : <a href={SITE.url}>{SITE.url}</a>
        </p>
      </div>
    </div>
  </section>
</PageLayout>
