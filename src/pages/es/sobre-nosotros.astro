---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absoluteUrl, getHomePath, getLegalPaths } from '../../lib/paths';
import { SITE } from '../../lib/site';
import { t } from '../../i18n/ui';
import type { Locale } from '../../lib/site';

const locale: Locale = 'es';
const canonical = absoluteUrl(getLegalPaths(locale).about);
const hreflang = [
  { lang: 'fr', href: absoluteUrl('/a-propos') },
  { lang: 'en', href: absoluteUrl('/en/about') },
  { lang: 'es', href: absoluteUrl('/es/sobre-nosotros') },
  { lang: 'nl', href: absoluteUrl('/nl/over-ons') },
  { lang: 'x-default', href: absoluteUrl('/a-propos') },
];
---

<PageLayout
  title="Acerca de — Viva Algérie"
  description="Viva Algérie es un medio editorial premium sobre inmobiliario, turismo e inversión en Argelia."
  locale={locale}
  canonical={canonical}
  hreflang={hreflang}
>
  <section class="section-pad">
    <div class="container-editorial max-w-3xl">
      <Breadcrumbs
        items={[
          { label: t(locale, 'breadcrumb.home'), href: getHomePath(locale) },
          { label: t(locale, 'about.title'), href: canonical },
        ]}
      />
      <h1 class="mb-6 text-4xl sm:text-5xl">Acerca de Viva Algérie</h1>
      <div class="prose-editorial">
        <p>
          <strong>Viva Algérie</strong> es un medio editorial independiente dedicado al inmobiliario,
          al turismo, a la inversión y a las dinámicas urbanas en Argelia. Nuestra línea: explicar,
          contextualizar y dotar de herramientas al lector — sin promesas de rentabilidad ni
          asesoramiento jurídico disfrazado.
        </p>
        <p>
          Publicamos análisis, guías prácticas y dossiers temáticos para compradores, la diáspora,
          observadores del mercado y cualquiera que desee comprender mejor la realidad del terreno argelino.
        </p>
        <h2>Nuestro método</h2>
        <ul>
          <li>Prioridad a fuentes oficiales y textos argelinos (ONS, ONAT, leyes, instituciones).</li>
          <li>Distinción clara entre hechos establecidos, hipótesis y lecturas editoriales.</li>
          <li>S.A.F.E presentado como metodología internacional propietaria de análisis y preselección inmobiliaria, geográficamente neutral y no como sello estatal.</li>
        </ul>
        <h2>Contacto</h2>
        <p>
          Editorial: <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          Site: <a href={SITE.url}>{SITE.url}</a>
        </p>
      </div>
    </div>
  </section>
</PageLayout>
