---
import { getCollection } from 'astro:content';
import GentlemenReferenceArticle from '../../components/GentlemenReferenceArticle.astro';

export async function getStaticPaths() {
  const articles = await getCollection(
    'articles',
    ({ data }) => !data.draft && data.lang === 'en' && Boolean(data.canonicalPath),
  );
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
---

<GentlemenReferenceArticle article={article} />
