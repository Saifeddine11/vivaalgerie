---
import PageLayout from '../../../layouts/PageLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import {
  absoluteUrl,
  formatDate,
  getArticlePath,
  getCategoryPath,
  getHomePath,
  readingTime,
} from '../../../lib/paths';
import { getRelatedArticles, extractFaqsFromMarkdown } from '../../../lib/content';
import { CATEGORY_LABELS, t } from '../../../i18n/ui';
import { SITE, type Locale } from '../../../lib/site';
import { articleHreflang } from '../../../lib/hreflang';

const locale = 'en' as const;

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft && data.lang === 'en');
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const related = await getRelatedArticles(article, 3);
const minutes = readingTime(article.body ?? '');
const canonical = absoluteUrl(getArticlePath(locale, article.data.slug));
const key = article.data.translationKey ?? article.data.slug;
const allLang = await getCollection('articles', ({ data }) => !data.draft && (data.translationKey === key || data.slug === key));
const slugs: Partial<Record<Locale, string>> = {};
for (const a of allLang) slugs[a.data.lang as Locale] = a.data.slug;
const faqs = extractFaqsFromMarkdown(article.body ?? '');

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.description,
  image: absoluteUrl(article.data.image),
  datePublished: article.data.pubDate.toISOString(),
  dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: article.data.author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: canonical,
  inLanguage: locale,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(locale, 'breadcrumb.home'), item: absoluteUrl(getHomePath(locale)) },
    { '@type': 'ListItem', position: 2, name: CATEGORY_LABELS[locale][article.data.category], item: absoluteUrl(getCategoryPath(locale, article.data.category)) },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: canonical },
  ],
};

const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---

<PageLayout
  title={article.data.title}
  description={article.data.description}
  locale={locale}
  canonical={canonical}
  image={article.data.image}
  type="article"
  hreflang={articleHreflang(slugs, article.data.slug)}
  jsonLd={[blogPosting, breadcrumbLd, faqLd].filter(Boolean) as Record<string, unknown>[]}
>
  <article class="pb-20">
    <header class="border-b border-border bg-bg-secondary">
      <div class="container-editorial max-w-4xl py-12 sm:py-16">
        <Breadcrumbs
          items={[
            { label: t(locale, 'breadcrumb.home'), href: getHomePath(locale) },
            { label: CATEGORY_LABELS[locale][article.data.category], href: getCategoryPath(locale, article.data.category) },
            { label: article.data.title, href: canonical },
          ]}
        />
        <p class="eyebrow mb-4">{CATEGORY_LABELS[locale][article.data.category]}</p>
        <h1 class="mb-5 text-3xl sm:text-5xl">{article.data.title}</h1>
        <p class="mb-6 text-lg text-muted">{article.data.description}</p>
        <div class="flex flex-wrap gap-4 text-sm text-muted">
          <span>{t(locale, 'article.by')} {article.data.author}</span>
          <time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate, locale)}</time>
          <span>{minutes} {t(locale, 'article.minRead')}</span>
        </div>
      </div>
      <div class="container-editorial max-w-5xl pb-12">
        <div class="overflow-hidden rounded-[1.5rem] border border-border">
          <img src={article.data.image} alt={article.data.imageAlt} class="aspect-[21/9] w-full object-cover" width="1400" height="600" fetchpriority="high" />
        </div>
      </div>
    </header>
    <div class="container-editorial max-w-3xl py-12">
      <div class="prose-editorial"><Content /></div>
      <aside class="mt-10 rounded-2xl border border-red-soft bg-red-soft/40 px-5 py-4 text-sm text-muted">
        {t(locale, 'article.disclaimer')}
      </aside>
    </div>
    {related.length > 0 && (
      <section class="border-t border-border bg-bg-secondary py-16">
        <div class="container-editorial">
          <h2 class="mb-8 text-3xl">{t(locale, 'article.related')}</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <ArticleCard
                title={r.data.title}
                description={r.data.description}
                slug={r.data.slug}
                category={r.data.category}
                lang={locale}
                pubDate={r.data.pubDate}
                image={r.data.image}
                imageAlt={r.data.imageAlt}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</PageLayout>
