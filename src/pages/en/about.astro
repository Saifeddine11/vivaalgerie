---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absoluteUrl, getHomePath, getLegalPaths } from '../../lib/paths';
import { SITE } from '../../lib/site';
import { t } from '../../i18n/ui';
import type { Locale } from '../../lib/site';

const locale: Locale = 'en';
const canonical = absoluteUrl(getLegalPaths(locale).about);
const hreflang = [
  { lang: 'fr', href: absoluteUrl('/a-propos') },
  { lang: 'en', href: absoluteUrl('/en/about') },
  { lang: 'es', href: absoluteUrl('/es/sobre-nosotros') },
  { lang: 'nl', href: absoluteUrl('/nl/over-ons') },
  { lang: 'x-default', href: absoluteUrl('/a-propos') },
];
---

<PageLayout
  title="About — Viva Algérie"
  description="Viva Algérie is a premium editorial medium on real estate, tourism and investment in Algeria."
  locale={locale}
  canonical={canonical}
  hreflang={hreflang}
>
  <section class="section-pad">
    <div class="container-editorial max-w-3xl">
      <Breadcrumbs
        items={[
          { label: t(locale, 'breadcrumb.home'), href: getHomePath(locale) },
          { label: t(locale, 'about.title'), href: canonical },
        ]}
      />
      <h1 class="mb-6 text-4xl sm:text-5xl">About Viva Algérie</h1>
      <div class="prose-editorial">
        <p>
          <strong>Viva Algérie</strong> is an independent editorial medium dedicated to real estate,
          tourism, investment and urban dynamics in Algeria. Our line: explain, contextualise and
          equip the reader — without return promises and without disguised legal advice.
        </p>
        <p>
          We publish analyses, practical guides and thematic dossiers for buyers, the diaspora,
          market observers and anyone who wants to better understand Algerian ground reality.
        </p>
        <h2>Our method</h2>
        <ul>
          <li>Priority to official sources and Algerian texts (ONS, ONAT, laws, institutions).</li>
          <li>Clear distinction between established facts, hypotheses and editorial readings.</li>
          <li>S.A.F.E presented as an international proprietary real estate analysis and pre-screening methodology, geographically neutral and not as a state label.</li>
        </ul>
        <h2>Contact</h2>
        <p>
          Editorial: <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          Site: <a href={SITE.url}>{SITE.url}</a>
        </p>
      </div>
    </div>
  </section>
</PageLayout>
