---
import CategoryPage from '../../components/CategoryPage.astro';
import { absoluteUrl } from '../../lib/paths';

const hreflang = [
  { lang: 'fr', href: absoluteUrl('/economie') },
  { lang: 'en', href: absoluteUrl('/en/economy') },
  { lang: 'es', href: absoluteUrl('/es/economia') },
  { lang: 'nl', href: absoluteUrl('/nl/economie') },
  { lang: 'x-default', href: absoluteUrl('/economie') },
];
---

<CategoryPage
  category="economie"
  locale="en"
  title="Algerian Economy — Energy, currency and strategic sectors"
  description="Viva Algérie economy coverage: gas, energy security, currency, trade, industry, investment and economic sovereignty."
  h1="Algerian Economy"
  intro="A sourced reading of Algeria's economic choices: hydrocarbons, diversification, external demand, currency and public policy."
  relatedLinks={[
    { href: '/en/articles/algerie-energie-souverainete-gaz', label: 'Gas and sovereignty' },
    { href: '/en/investment', label: 'Investment' },
    { href: '/en/analysis', label: 'Analysis' },
  ]}
  hreflang={hreflang}
/>
