---
import CategoryPage from '../../components/CategoryPage.astro';
import { absoluteUrl } from '../../lib/paths';

const hreflang = [
  { lang: "fr", href: absoluteUrl("/analyses") },
  { lang: "en", href: absoluteUrl("/en/analysis") },
  { lang: "es", href: absoluteUrl("/es/analisis") },
  { lang: "nl", href: absoluteUrl("/nl/analyses") },
  { lang: "x-default", href: absoluteUrl("/analyses") },
];
---

<CategoryPage
  category="analyses"
  locale="en"
  title="Analysis — Market, policy and urban dynamics in Algeria"
  description="In-depth Viva Algérie analysis: infrastructure, property market, tourism and strategic reading of the territory."
  h1="Analysis"
  intro="Deep dives to situate real estate and investment in Algeria’s economic and urban context."
  relatedLinks={[
    { href: "/en/real-estate", label: "Real estate" },
    { href: "/en/investment", label: "Investment" },
    { href: "/en/safe-real-estate-certification", label: "S.A.F.E" },
  ]}
  hreflang={hreflang}
/>
