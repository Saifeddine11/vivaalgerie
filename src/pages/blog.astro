---
import PageLayout from '../layouts/PageLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { absoluteUrl, getBlogPath, getHomePath } from '../lib/paths';
import { getArticles } from '../lib/content';
import { t } from '../i18n/ui';

const locale = 'fr' as const;
const articles = await getArticles(locale);
const canonical = absoluteUrl('/blog');
const hreflang = [
  { lang: 'fr', href: canonical },
  { lang: 'en', href: absoluteUrl('/en/blog') },
  { lang: 'es', href: absoluteUrl('/es/blog') },
  { lang: 'nl', href: absoluteUrl('/nl/blog') },
  { lang: 'x-default', href: canonical },
];
---

<PageLayout
  title="Blog — Analyses et guides Viva Algérie"
  description="Tous les articles Viva Algérie : immobilier, tourisme, investissement, villes, guides et analyses."
  locale={locale}
  canonical={canonical}
  hreflang={hreflang}
>
  <section class="border-b border-border bg-bg-secondary">
    <div class="container-editorial max-w-4xl py-14 sm:py-20">
      <Breadcrumbs
        items={[
          { label: t(locale, 'breadcrumb.home'), href: getHomePath(locale) },
          { label: t(locale, 'blog.title'), href: getBlogPath(locale) },
        ]}
      />
      <h1 class="mb-4 text-4xl sm:text-5xl">{t(locale, 'blog.title')}</h1>
      <p class="text-lg text-muted">{t(locale, 'blog.subtitle')}</p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-editorial grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            slug={article.data.slug}
            category={article.data.category}
            lang={locale}
            pubDate={article.data.pubDate}
            image={article.data.image}
            imageAlt={article.data.imageAlt}
          />
        ))
      }
    </div>
  </section>
</PageLayout>
