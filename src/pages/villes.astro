---
import PageLayout from '../layouts/PageLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CITIES } from '../lib/site';
import { absoluteUrl, getHomePath } from '../lib/paths';
import { getArticlesByCategory } from '../lib/content';
import { t } from '../i18n/ui';

const locale = 'fr' as const;
const articles = await getArticlesByCategory('villes', locale);
const canonical = absoluteUrl('/villes');
const hreflang = [
  { lang: 'fr', href: canonical },
  { lang: 'en', href: absoluteUrl('/en/cities') },
  { lang: 'es', href: absoluteUrl('/es/ciudades') },
  { lang: 'nl', href: absoluteUrl('/nl/steden') },
  { lang: 'x-default', href: canonical },
];
---

<PageLayout
  title="Villes d’Algérie — Alger, Oran, Constantine et au-delà"
  description="Guides urbains Algérie : Alger, Oran, Constantine, Annaba, Béjaïa, Tipaza et les dynamiques locales immobilier / tourisme."
  locale={locale}
  canonical={canonical}
  hreflang={hreflang}
>
  <section class="border-b border-border bg-bg-secondary">
    <div class="container-editorial max-w-4xl py-14 sm:py-20">
      <Breadcrumbs
        items={[
          { label: t(locale, 'breadcrumb.home'), href: getHomePath(locale) },
          { label: 'Villes', href: canonical },
        ]}
      />
      <p class="eyebrow mb-3">Villes</p>
      <h1 class="mb-5 text-4xl sm:text-5xl">Villes d’Algérie</h1>
      <p class="max-w-2xl text-lg text-muted">
        Comprendre les dynamiques locales : capitales régionales, littoral et villes secondaires à
        suivre pour l’immobilier et le tourisme.
      </p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-editorial">
      <h2 class="mb-8 text-3xl">Villes à suivre</h2>
      <div class="mb-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          CITIES.map((city) => (
            <div
              id={city.slug}
              class="scroll-mt-24 rounded-[var(--radius-card)] border border-border bg-bg p-5"
            >
              <h3 class="font-serif text-xl">{city.name.fr}</h3>
              <p class="mt-2 text-sm text-muted">
                Point d’attention éditorial : immobilier, accessibilité et potentiel touristique
                local.
              </p>
            </div>
          ))
        }
      </div>

      <h2 class="mb-8 text-3xl">Articles</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              slug={article.data.slug}
              category={article.data.category}
              lang={locale}
              pubDate={article.data.pubDate}
              image={article.data.image}
              imageAlt={article.data.imageAlt}
            />
          ))
        }
      </div>

      <aside class="mt-16 rounded-[var(--radius-card)] border border-border bg-bg-secondary p-8">
        <h2 class="mb-4 text-2xl">Ressources liées</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          <li><a href="/immobilier" class="text-green hover:underline">Immobilier →</a></li>
          <li><a href="/tourisme" class="text-green hover:underline">Tourisme →</a></li>
          <li><a href="/prix-immobilier-alger" class="text-green hover:underline">Prix à Alger →</a></li>
          <li><a href="/investissement" class="text-green hover:underline">Investissement →</a></li>
        </ul>
      </aside>
    </div>
  </section>
</PageLayout>
