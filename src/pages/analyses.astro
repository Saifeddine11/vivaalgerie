---
import CategoryPage from '../components/CategoryPage.astro';
import { absoluteUrl } from '../lib/paths';

const hreflang = [
  { lang: 'fr', href: absoluteUrl('/analyses') },
  { lang: 'en', href: absoluteUrl('/en/analysis') },
  { lang: 'es', href: absoluteUrl('/es/analisis') },
  { lang: 'nl', href: absoluteUrl('/nl/analyses') },
  { lang: 'x-default', href: absoluteUrl('/analyses') },
];
---

<CategoryPage
  category="analyses"
  title="Analyses — géopolitique, économie et grands enjeux de l’Algérie"
  description="Analyses approfondies Viva Algérie : Sahara occidental, Algérie–Maroc, économie, culture politique, tourisme et dynamiques du Maghreb."
  h1="Analyses"
  intro="Décryptages de fond pour comprendre les grands enjeux algériens : souveraineté, Maghreb, diplomatie, économie, tourisme, culture et rapports de force régionaux."
  relatedLinks={[
    { href: '/sahara-occidental', label: 'Sahara occidental' },
    { href: '/algerie-maroc', label: 'Algérie–Maroc' },
    { href: '/algerie-vs-maroc', label: 'Algérie vs Maroc' },
    { href: '/economie', label: 'Économie' },
  ]}
  hreflang={hreflang}
/>
