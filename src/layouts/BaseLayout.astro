---
import '../styles/global.css';
import { SITE, type Locale } from '../lib/site';
import { absoluteUrl } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  hreflang?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogLocale?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title,
  description,
  locale = 'fr',
  canonical,
  image = '/images/og-default.webp',
  type = 'website',
  noindex = false,
  hreflang = [],
  jsonLd = [],
  ogLocale,
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
} = Astro.props;

const canonicalUrl = canonical ?? absoluteUrl(Astro.url.pathname.replace(/\.html$/, ''));
const imageUrl = image.startsWith('http') ? image : absoluteUrl(image);
const fullTitle = title.includes('Viva Algérie') ? title : `${title} | Viva Algérie`;
const socialTitle = ogTitle ?? fullTitle;
const socialDescription = ogDescription ?? description;
const twTitle = twitterTitle ?? socialTitle;
const twDescription = twitterDescription ?? socialDescription;
const ogLoc =
  ogLocale ??
  ({ fr: 'fr_DZ', en: 'en_GB', es: 'es_ES', nl: 'nl_NL' }[locale] ?? 'fr_DZ');

const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const htmlLang = locale === 'fr' ? 'fr' : locale;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {!noindex && <meta name="robots" content="index,follow,max-image-preview:large" />}

    {hreflang.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLoc} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twTitle} />
    <meta name="twitter:description" content={twDescription} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    {schemas.filter(Boolean).map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen bg-bg text-text">
    <slot />
  </body>
</html>
